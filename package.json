{
  "name": "okuyuki-ui-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run dev:prototype",
    "dev:prototype": "pnpm --filter @naname/prototype dev",
    "dev:modeling": "pnpm --filter @naname/modeling dev",
    "build": "pnpm --filter @naname/prototype build && pnpm --filter @naname/modeling build",
    "build:prototype": "pnpm --filter @naname/prototype build",
    "build:modeling": "pnpm --filter @naname/modeling build",
    "preview": "pnpm run preview:prototype",
    "preview:prototype": "pnpm --filter @naname/prototype preview",
    "preview:modeling": "pnpm --filter @naname/modeling preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm --filter @naname/prototype test && pnpm --filter @naname/modeling test",
    "test:prototype": "pnpm --filter @naname/prototype test",
    "test:modeling": "pnpm --filter @naname/modeling test",
    "test:watch": "pnpm --filter @naname/prototype test:watch",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "e2e": "pnpm run e2e:prototype && pnpm run e2e:modeling",
    "e2e:prototype": "pnpm run build:prototype && PLAYWRIGHT_APP=prototype PLAYWRIGHT_SERVER_MODE=preview PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173 pnpm exec playwright test --grep @prototype",
    "e2e:modeling": "pnpm run build:modeling && PLAYWRIGHT_APP=modeling PLAYWRIGHT_SERVER_MODE=preview PLAYWRIGHT_BASE_URL=http://127.0.0.1:4174 pnpm exec playwright test --grep @modeling",
    "e2e:ui": "pnpm run build && PLAYWRIGHT_SERVER_MODE=preview PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173 pnpm exec playwright test --ui",
    "e2e:dev": "PLAYWRIGHT_SKIP_WEBSERVER=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173 pnpm exec playwright test",
    "e2e:dev:ui": "PLAYWRIGHT_SKIP_WEBSERVER=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173 pnpm exec playwright test --ui",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "knip": "knip"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/rapier": "^2.2.0",
    "lucide-react": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "knip": "^6.6.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
